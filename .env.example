# ==============================================================================
# CẤU HÌNH LOCAL MCP & REST SERVER DÀNH CHO GPT
# ==============================================================================

# Thư mục làm việc mà GPT được phép truy cập (Mặc định: thư mục hiện tại)
WORKSPACE_DIR=c:/Users/admin/Documents/antigravity/adventurous-faraday

# Cổng mạng server local
PORT=8000
HOST=0.0.0.0

# Ngrok Authtoken (Lấy miễn phí tại: https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Tên miền tùy chỉnh Ngrok (chỉ dành cho tài khoản trả phí hoặc static domain miễn phí)
# Ví dụ: my-domain.ngrok-free.app
NGROK_DOMAIN=

# Khóa bảo mật tùy chọn (để trống nếu không muốn yêu cầu xác thực API key)
API_KEY=

# Cho phép GPT thực thi lệnh dòng lệnh (PowerShell) trong thư mục làm việc
ENABLE_COMMAND_EXECUTION=true
COMMAND_TIMEOUT_SECONDS=60

# Cấp độ triết lý Ponytail: lite (nhẹ), full (chuẩn), ultra (cực kỳ tối giản)
PONYTAIL_MODE=full
